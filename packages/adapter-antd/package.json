{
  "name": "@protoform/adapter-antd",
  "version": "0.9.0",
  "description": "Ant Design adapter for ProtoForm",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@protoform/react": "workspace:*"
  },
  "peerDependencies": {
    "antd": ">=5.0.0",
    "dayjs": ">=1.11.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "dayjs": "^1.11.19",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "author": "IO CORP PTY LTD (Alexander Collins)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderCollins/protoform.git",
    "directory": "packages/adapter-antd"
  },
  "homepage": "https://github.com/AlexanderCollins/protoform#readme"
}
