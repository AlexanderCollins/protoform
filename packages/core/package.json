{
  "name": "@protoform/core",
  "version": "0.9.0",
  "description": "Pure TypeScript engine for schema-driven forms \u2014 zero dependencies",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "author": "IO CORP PTY LTD (Alexander Collins)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderCollins/protoform.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/AlexanderCollins/protoform#readme"
}
